algoritmo "escopoParametro"

var
  numero: inteiro

procedimento mostrarValor()
  var
    valor: inteiro

  inicio
    valor <- 2
    escreval("Número: ", numero)//10
    escreval("Número: ", valor)//2
fimprocedimento

inicio
  numero <- 10
  mostrarValor()
  escreval("Valor: ", valor)// Erro: Variavel não declarada: valor

fimalgoritmo

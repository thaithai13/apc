algoritmo "MenuLanchonete"

var
  opcao: inteiro

inicio
  escreval("1 - Hamburguer | 2 - Pizza | 3 - Salada")
  leia(opcao)

  escolha opcao
    caso 1
    escreval("Preparando Hamburguer...")
    caso 2
    escreval("Assando Pizza...")
    caso 3 
    escreval("Cortando Salada...")
  fimescolha

fimalgoritmo